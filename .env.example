# DevBrain configuration — copy to `.env` and adjust as needed.
# Every value is optional: DevBrain runs with sane defaults out of the box.
# Environment variables override ~/.devbrain/config.json.

# --- Storage ---
# SQLite database file (WAL mode, auto-created).
# Default: ~/.devbrain/devbrain.db
DEVBRAIN_DB_PATH=

# --- Embeddings ---
# Provider: openai | ollama | none
# When unset, it is inferred: "openai" if an OpenAI key is present, else "ollama".
DEVBRAIN_EMBEDDING_PROVIDER=

# OpenAI (used when provider = openai). OPENAI_API_KEY is also accepted.
DEVBRAIN_OPENAI_API_KEY=
# Default: text-embedding-3-small (1536 dimensions)
DEVBRAIN_OPENAI_MODEL=

# Ollama (used when provider = ollama — fully local, no API key required).
# Default: http://localhost:11434
DEVBRAIN_OLLAMA_BASE_URL=
# Default: nomic-embed-text (768 dimensions)
DEVBRAIN_OLLAMA_MODEL=

# Override the vector dimension (advanced; normally derived from the provider).
DEVBRAIN_EMBEDDING_DIMENSION=

# --- Transport ---
# stdio (default, used by MCP clients) | sse
DEVBRAIN_TRANSPORT=
# TCP port for the SSE transport (only relevant when transport = sse).
DEVBRAIN_PORT=

# --- Claude Code hooks ---
# HTTP port for the local hooks bridge. Default: 7384
DEVBRAIN_HOOK_PORT=

# --- Danger zone ---
# Set to 1 to allow dropping & recreating the vec0 tables when the embedding
# dimension changes (e.g. switching openai 1536 <-> ollama 768). Without this,
# DevBrain refuses the destructive recreate to protect existing embeddings.
DEVBRAIN_ALLOW_EMBEDDING_RECREATE=
