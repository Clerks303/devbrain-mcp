{
  "name": "devbrain-mcp",
  "version": "0.1.1",
  "description": "Persistent project memory MCP server — knowledge graph + learning for AI coding agents",
  "license": "MIT",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "devbrain-mcp": "dist/bin/devbrain.js",
    "devbrain-install-hooks": "dist/bin/devbrain-install-hooks.js",
    "devbrain-daemon": "dist/bin/devbrain-daemon.js"
  },
  "scripts": {
    "build": "tsc && node scripts/add-shebang.js && node scripts/copy-hooks.js",
    "dev": "tsc --watch",
    "start": "node dist/src/index.js",
    "daemon": "node dist/bin/devbrain-daemon.js",
    "daemon:start": "node dist/bin/devbrain-daemon.js start --foreground",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^11.7.0",
    "chokidar": "^4.0.3",
    "sqlite-vec": "^0.1.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "memory",
    "knowledge-graph",
    "ai-agents",
    "devbrain"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Clerks303/devbrain-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Clerks303/devbrain-mcp/issues"
  },
  "homepage": "https://github.com/Clerks303/devbrain-mcp#readme"
}
